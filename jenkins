pipeline {
    agent none
    options { 
        timestamps() 
        timeout(time: 15, unit: 'MINUTES') 
    }
    environment {
        VITE_BUILD_DIR = 'dist'
    }
    stages {
        stage('Checkout') {
            agent { label 'termux' }
            tools {
                git 'git-linux'  // Use your configured Git tool name
            }
            steps {
                checkout scm  // This will now use the correct git command
            }
        }

        stage('Install Dependencies') {
            agent { label 'termux' }
            steps {
                sh '''
                    echo "Running on AGENT: $(hostname)"
                    echo "Current directory: $(pwd)"
                    ls -la
                    npm ci
                '''
            }
        }

        stage('Build & Test') {
            agent { label 'termux' }
            steps {
                sh 'npm run build'
            }
        }

        stage('Archive Artifacts') {
            agent { label 'termux' }
            steps {
                archiveArtifacts artifacts: "${VITE_BUILD_DIR}/**", fingerprint: true
                echo "Vite build artifacts saved from ${VITE_BUILD_DIR}."
            }
        }
    }
}