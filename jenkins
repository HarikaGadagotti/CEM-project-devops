pipeline {
    agent none
    options { 
        timestamps() 
        timeout(time: 15, unit: 'MINUTES') 
    }
    environment {
        VITE_BUILD_DIR = 'dist'
    }
    stages {
        stage('Checkout') {
            agent { label 'termux' }
            steps {
                sh '''
                    echo "Cleaning workspace..."
                    # More thorough cleanup
                    find . -mindepth 1 -delete || true
                    
                    echo "Cloning repository..."
                    git clone https://github.com/HarikaGadagotti/CEM-project-devops.git .
                    
                    echo "Repository cloned successfully."
                    ls -la
                '''
            }
        }

        stage('Install Dependencies') {
            agent { label 'termux' }
            steps {
                sh '''
                    echo "Running on AGENT: $(hostname)"
                    echo "Current directory: $(pwd)"
                    echo "Contents:"
                    ls -la
                    npm ci
                '''
            }
        }

        stage('Build & Test') {
            agent { label 'termux' }
            steps {
                sh 'npm run build'
            }
        }

        stage('Archive Artifacts') {
            agent { label 'termux' }
            steps {
                archiveArtifacts artifacts: "${VITE_BUILD_DIR}/**", fingerprint: true
                echo "Vite build artifacts saved from ${VITE_BUILD_DIR}."
            }
        }
    }
}